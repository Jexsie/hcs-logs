{
  "name": "sh",
  "version": "0.0.1",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/nextjs"
    ]
  },
  "scripts": {
    "format": "npm run next:format --",
    "lint": "npm run next:lint --",
    "next:build": "npm run build -w @sh/nextjs --",
    "next:check-types": "npm run check-types -w @sh/nextjs --",
    "next:dev": "npm run dev -w @sh/nextjs --",
    "next:format": "npm run format -w @sh/nextjs --",
    "next:lint": "npm run lint -w @sh/nextjs --",
    "next:serve": "npm run serve -w @sh/nextjs --",
    "next:start": "npm run start -w @sh/nextjs --",
    "prepare": "husky",
    "test": "npm run test -w @sh/nextjs --",
    "token:create": "npm run token:create -w @sh/nextjs --"
  },
  "devDependencies": {
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10"
  },
  "packageManager": "npm@10.0.0",
  "engines": {
    "node": "^24.21.0"
  }
}
