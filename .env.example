# Network to use: testnet, mainnet or previewnet
HEDERA_NETWORK=

# Association treasury account: pays for setup, holds the Freight supply, collects fees
OPERATOR_ID=

# Treasury private key (DER, or 0x-prefixed ECDSA hex)
OPERATOR_KEY=

# Infrastructure operator account, the second fee collector
INFRA_ID=

# Infrastructure operator private key, used once to associate Freight
INFRA_KEY=

# The four committee representatives' private keys, comma-separated (local testing only)
COMMITTEE_KEYS=

# Committee signatures required to change the fee (default 3)
COMMITTEE_THRESHOLD=

# Lakeside Haulage, a member company that pays the fee
MEMBER_LAKESIDE_ID=

# Lakeside Haulage private key
MEMBER_LAKESIDE_KEY=

# Nile Cargo Services, a member company that pays the fee
MEMBER_NILE_ID=

# Nile Cargo Services private key
MEMBER_NILE_KEY=

# Rift Valley Logistics, a member company that pays the fee
MEMBER_RIFT_ID=

# Rift Valley Logistics private key
MEMBER_RIFT_KEY=

# Freight token id, printed by token:create
FREIGHT_TOKEN_ID=

# Records topic id, printed by topic:create
TOPIC_ID=

# Freight paid to the association treasury per submission (default 2)
TREASURY_FEE=

# Freight paid to the infrastructure operator per submission (default 1)
INFRA_FEE=

# Most Freight a member will pay per submission across both collectors (default 3)
MAX_CUSTOM_FEE=

# Optional mirror node override; defaults to the public one
MIRROR_NODE_URL=
